---
import { getImage } from "astro:assets";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import styles from "../../styles.css?raw";
import { GA_MEASUREMENT_ID, SITE_URL } from "../consts";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  keywords?: string[];
  publishedDate?: Date;
}

const {
  title,
  description,
  type = "website",
  keywords = [],
  publishedDate,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const icon = await getImage({
  src: portrait,
  width: 144,
  height: 144,
  fit: "cover",
  position: "attention",
  format: "webp",
});
const socialImage = await getImage({
  src: portrait,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "attention",
  format: "jpeg",
});
const socialImageURL = new URL(socialImage.src, SITE_URL).href;
const analyticsConfig = JSON.stringify({
  vars: {
    gtag_id: GA_MEASUREMENT_ID,
    config: { [GA_MEASUREMENT_ID]: { groups: "default" } },
  },
});
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html amp lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style amp-boilerplate is:inline>body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}</style>
    <noscript>
      <style amp-boilerplate is:inline>body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}</style>
    </noscript>
    <style amp-custom is:inline set:html={styles}></style>
    <script async src="https://cdn.ampproject.org/v0.js"></script>
    <script
      async
      custom-element="amp-analytics"
      src="https://cdn.ampproject.org/v0/amp-analytics-0.1.js"
    ></script>
    <script
      async
      custom-element="amp-auto-ads"
      src="https://cdn.ampproject.org/v0/amp-auto-ads-0.1.js"
    ></script>
    <meta name="description" content={description} />
    <meta name="author" content="Sumit Kumar" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/webp" href={icon.src} />
    <link rel="apple-touch-icon" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sumit Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Sumit Kumar, DevOps Engineer" />
    <meta property="og:locale" content="en_IN" />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <title>{title}</title>
  </head>
  <body
    class={
      Astro.url.pathname === "/"
        ? "home-page"
        : Astro.url.pathname.startsWith("/blogs/")
          ? "blog-page"
          : undefined
    }
  >
    <amp-auto-ads
      type="adsense"
      data-ad-client="ca-pub-2603058492307351"
    ></amp-auto-ads>
    <slot />
    <amp-analytics type="gtag" data-credentials="include">
      <script type="application/json" set:html={analyticsConfig}></script>
    </amp-analytics>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Sumit Kumar</span>
      <a href={`${base}privacy-policy/`}>Privacy Policy</a>
    </footer>
  </body>
</html>