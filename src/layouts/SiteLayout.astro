---
import { getImage } from "astro:assets";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import "../../styles.css";
import { GA_MEASUREMENT_ID, SITE_URL } from "../consts";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  keywords?: string[];
  publishedDate?: Date;
}

const {
  title,
  description,
  type = "website",
  keywords = [],
  publishedDate,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const icon = await getImage({
  src: portrait,
  width: 144,
  height: 144,
  fit: "cover",
  position: "attention",
  format: "webp",
});
const socialImage = await getImage({
  src: portrait,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "attention",
  format: "jpeg",
});
const socialImageURL = new URL(socialImage.src, SITE_URL).href;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Sumit Kumar" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/webp" href={icon.src} />
    <link rel="apple-touch-icon" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sumit Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Sumit Kumar, DevOps Engineer" />
    <meta property="og:locale" content="en_IN" />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <title>{title}</title>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2603058492307351"
      crossorigin="anonymous"
    ></script>
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-K5CVG3DB2R");
    </script>
  </head>
  <body
    class={
      Astro.url.pathname === "/"
        ? "home-page"
        : Astro.url.pathname.startsWith("/blogs/")
          ? "blog-page"
          : undefined
    }
  >
    <slot />
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Sumit Kumar</span>
      <a href={`${base}privacy-policy/`}>Privacy Policy</a>
    </footer>
  </body>
</html>