---
import { getImage } from "astro:assets";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import styles from "../../styles.css?raw";
import { GA_MEASUREMENT_ID, SITE_URL } from "../consts";

interface Props {
  title: string;
  description: string;
  author?: string;
  socialImageUrl?: string;
  socialImageAlt?: string;
  type?: "website" | "article";
  keywords?: string[];
  publishedDate?: Date;
  modifiedDate?: Date;
}

const {
  title,
  description,
  author = "Sumit Kumar",
  socialImageUrl,
  socialImageAlt = "Sumit Kumar, DevOps Engineer",
  type = "website",
  keywords = [],
  publishedDate,
  modifiedDate,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const hasAmpPage = Astro.url.pathname === "/blogs/" || /^\/blogs\/[^/]+\/$/.test(Astro.url.pathname);
const ampURL = Astro.url.pathname === "/"
  ? new URL("/amp/", SITE_URL).href
  : hasAmpPage
    ? new URL(`/amp${Astro.url.pathname}`, SITE_URL).href
    : undefined;
const icon = await getImage({
  src: portrait,
  width: 144,
  height: 144,
  fit: "cover",
  position: "attention",
  format: "png",
});
const socialImage = await getImage({
  src: portrait,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "attention",
  format: "jpeg",
});
const resolvedSocialImageURL = socialImageUrl ?? new URL(socialImage.src, SITE_URL).href;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline set:html={styles}></style>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    {ampURL && <link rel="amphtml" href={ampURL} />}
    <link rel="icon" type="image/png" sizes="144x144" href={icon.src} />
    <link rel="apple-touch-icon" href={icon.src} />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sumit Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedSocialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedSocialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {Astro.url.pathname.startsWith("/blogs/") && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Sumit Kumar's DevOps and Kubernetes blog"
        href={new URL(`${base}rss.xml`, SITE_URL).href}
      />
    )}
    <title>{title}</title>
  </head>
  <body
    class={
      Astro.url.pathname === "/"
        ? "home-page"
        : Astro.url.pathname.startsWith("/blogs/")
          ? "blog-page"
          : undefined
    }
  >
    <slot />
    <script is:inline data-measurement-id={GA_MEASUREMENT_ID}>
      (() => {
        const measurementId = document.currentScript.dataset.measurementId;
        const dataLayer = window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", measurementId);

        const appendScript = (src, crossOrigin) => {
          const script = document.createElement("script");
          script.async = true;
          if (crossOrigin) script.crossOrigin = crossOrigin;
          script.src = src;
          document.head.append(script);
        };

        const deferUntilInteraction = (callback, timeout) => {
          let loaded = false;
          const load = () => {
            if (loaded) return;
            loaded = true;
            events.forEach((event) => {
              window.removeEventListener(event, load);
            });
            callback();
          };
          const events = ["pointerdown", "keydown", "touchstart", "wheel"];
          events.forEach((event) => {
            window.addEventListener(event, load, { once: true, passive: true });
          });
          window.setTimeout(load, timeout);
        };

        const loadAnalytics = () => {
          appendScript(`https://www.googletagmanager.com/gtag/js?id=${measurementId}`);
        };
        const loadAds = () => {
          appendScript(
            "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2603058492307351",
            "anonymous",
          );
        };

        const loadThirdPartyScripts = () => {
          deferUntilInteraction(loadAnalytics, 20000);
          deferUntilInteraction(loadAds, 30000);
        };

        const startDeferredScripts = () => {
          if (document.readyState === "complete") {
            loadThirdPartyScripts();
          } else {
            window.addEventListener("load", loadThirdPartyScripts, { once: true });
          }
        };

        startDeferredScripts();
      })();
    </script>
    <script src="/theme-toggle.js" defer is:inline></script>
    <footer class="site-footer">
      <div class="footer-brand">
        <span class="footer-monogram" aria-hidden="true">SK</span>
        <span class="footer-copy">
          <strong>Sumit Kumar</strong>
          <span>AI · Cloud · Platform Engineering</span>
        </span>
      </div>
      <span class="footer-copyright">© {new Date().getFullYear()}</span>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href={`${base}privacy-policy/`}>Privacy Policy</a>
        <a href={`${base}#home`}>Back to top <span aria-hidden="true">↑</span></a>
      </nav>
    </footer>
  </body>
</html>