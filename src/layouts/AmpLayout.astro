---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  imageUrl?: string;
}

const { title, description, canonicalUrl, imageUrl } = Astro.props;
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import { SITE_URL } from "../consts";

const socialImageUrl = imageUrl ?? new URL(portrait.src, SITE_URL).href;

const ampStyles = `
  :root {
    --canvas: #ffffff;
    --paper: #ffffff;
    --ink: #20352b;
    --muted: #56616a;
    --line: #e3e3d9;
    --green: #355d48;
    --green-deep: #264636;
    --terracotta: #bb7154;
    --mono: "SFMono-Regular", Consolas, monospace;
    --sans: Arial, sans-serif;
  }
  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--canvas);
    color: var(--ink);
    line-height: 1.6;
  }
  a {
    color: var(--green);
    text-decoration: none;
  }
  p, li, h1, h2, h3 {
    margin-top: 0;
  }
  .amp-shell {
    max-width: 1040px;
    margin: 0 auto;
    padding: 20px 16px 48px;
  }
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .brand {
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
  }
  .hero {
    display: grid;
    gap: 20px;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    padding: 12px 0 20px;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--green);
    letter-spacing: 0.12em;
    font-size: 10px;
    font-family: var(--mono);
    text-transform: uppercase;
  }
  h1, h2, h3 {
    color: var(--ink);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 5rem);
    margin-bottom: 16px;
  }
  h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 12px;
  }
  .lede {
    max-width: 620px;
    font-size: 1.06rem;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    font-size: 12px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 999px;
    background: #edf2e8;
    color: var(--green-deep);
    font-weight: 700;
  }
  .card {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px;
  }
  .card amp-img {
    display: block;
    border-radius: 12px;
  }
  .section {
    margin-top: 26px;
  }
  .list {
    display: grid;
    gap: 12px;
    padding-left: 20px;
  }
  .article {
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px;
  }
  .article h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }
  .article p {
    margin: 0;
    color: var(--muted);
  }
  .blog-body {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px;
    font-size: 18px;
    line-height: 1.8;
  }
  .blog-body h2,
  .blog-body h3,
  .blog-body h4 {
    margin-top: 1.4em;
  }
  .blog-body code {
    background: #f0efe8;
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .blog-body pre {
    overflow: auto;
    background: #f4f3ef;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
  }
  .blog-body blockquote {
    border-left: 3px solid var(--green);
    padding-left: 14px;
    color: var(--muted);
  }
  .footer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
`;
---

<!doctype html>
<html amp lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <script async src="https://cdn.ampproject.org/v0.js"></script>
    <style amp-boilerplate is:inline>
      body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
    </style>
    <noscript>
      <style amp-boilerplate is:inline>
        body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}
      </style>
    </noscript>
    <style amp-custom is:inline set:html={ampStyles}></style>
    <meta property="og:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <div class="amp-shell">
      <slot />
    </div>
  </body>
</html>
