---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import BlogEntries from "../../components/BlogEntries.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import { SITE_URL } from "../../consts";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection("blogs", ({ data }) => !data.draft)).sort(
  (first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
);
const blogStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": new URL(`${base}blogs/#blog`, SITE_URL).href,
  name: "Sumit Kumar Blog",
  description: "Articles on DevOps, Kubernetes, cloud infrastructure, and observability.",
  url: new URL(`${base}blogs/`, SITE_URL).href,
  inLanguage: "en",
  author: {
    "@type": "Person",
    "@id": `${SITE_URL}#person`,
    name: "Sumit Kumar",
    url: SITE_URL,
    sameAs: [
      "https://github.com/sumiitkumar",
      "https://www.linkedin.com/in/sumiitkumar",
    ],
  },
  publisher: { "@id": `${SITE_URL}#person` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": new URL(`${base}blogs/${post.slug}/#article`, SITE_URL).href,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    articleSection: post.data.category,
    keywords: post.data.tags,
    url: new URL(`${base}blogs/${post.slug}/`, SITE_URL).href,
    author: { "@id": `${SITE_URL}#person` },
  })),
}).replaceAll("<", "\\u003c");
---

<SiteLayout
  title="Blogs | Sumit Kumar"
  description="Articles and notes on DevOps, Kubernetes, cloud infrastructure, and observability by Sumit Kumar."
  keywords={["DevOps blog", "Kubernetes", "Cloud infrastructure", "Observability", "Sumit Kumar"]}
>
  <script type="application/ld+json" set:html={blogStructuredData} />
  <main class="page">
    <article class="sheet">
      <nav class="topnav" aria-label="Primary navigation">
        <BrandLogo href={`${base}#home`} />
        <div class="navlinks">
          <a href={`${base}#home`}>Home</a>
          <a href={`${base}#about`}>About</a>
          <a href={`${base}#work`}>Projects</a>
          <a href={`${base}#experience`}>Experience</a>
          <a href={`${base}#skills`}>Skills</a>
          <a class="active" href={`${base}blogs/`}>Blogs</a>
          <a href={`${base}#contact`}>Contact</a>
        </div>
        <ThemeToggle />
      </nav>

      <header class="blog-heading">
        <p class="subname">NOTES AND WRITING</p>
        <h1>Blogs</h1>
      </header>
      <BlogEntries posts={posts} base={base} />

      <p class="blog-back"><a href={base}>← Back to portfolio</a></p>
    </article>
  </main>
</SiteLayout>