---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import BlogTags from "../../components/BlogTags.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import portrait from "../../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import { SITE_URL } from "../../consts";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

export async function getStaticPaths() {
  const posts = await getCollection("blogs", ({ data }) => !data.draft);

  return posts.map((post) => {
    const relatedPosts = posts
      .filter((candidate) => candidate.slug !== post.slug)
      .map((candidate) => ({
        post: candidate,
        sharedTags: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
      }))
      .filter(({ sharedTags }) => sharedTags > 0)
      .sort((first, second) => second.sharedTags - first.sharedTags)
      .slice(0, 3)
      .map(({ post: candidate }) => candidate);

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content } = await post.render();
const modifiedDate = post.data.updatedDate ?? post.data.pubDate;
if (post.data.coverImage && !post.data.coverImageAlt) {
  throw new Error(`Blog post "${post.slug}" defines coverImage without coverImageAlt.`);
}
const socialImage = await getImage({
  src: post.data.coverImage ?? portrait,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "attention",
  format: "jpeg",
});
const socialImageUrl = new URL(socialImage.src, SITE_URL).href;
const socialImageAlt = post.data.coverImage
  ? post.data.coverImageAlt ?? post.data.title
  : "Sumit Kumar, DevOps Engineer";
const articleStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: "en",
  keywords: post.data.tags,
  articleSection: [post.data.category, ...post.data.tags].filter(Boolean),
  wordCount: post.body.trim().split(/\s+/).length,
  image: new URL(socialImage.src, SITE_URL).href,
  author: {
    "@type": "Person",
    "@id": `${SITE_URL}#person`,
    name: post.data.author,
    url: SITE_URL,
    sameAs: [
      "https://github.com/sumiitkumar",
      "https://www.linkedin.com/in/sumiitkumar",
    ],
  },
  publisher: {
    "@type": "Person",
    "@id": `${SITE_URL}#person`,
    name: post.data.author,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, SITE_URL).href,
  },
}).replaceAll("<", "\\u003c");
const breadcrumbStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Blogs", item: new URL(`${base}blogs/`, SITE_URL).href },
    { "@type": "ListItem", position: 3, name: post.data.title, item: new URL(Astro.url.pathname, SITE_URL).href },
  ],
}).replaceAll("<", "\\u003c");
---

<SiteLayout
  title={post.data.seoTitle ?? `${post.data.title} | ${post.data.author}`}
  description={post.data.description}
  author={post.data.author}
  socialImageUrl={socialImageUrl}
  socialImageAlt={socialImageAlt}
  type="article"
  keywords={post.data.tags}
  publishedDate={post.data.pubDate}
  modifiedDate={modifiedDate}
>
  <script type="application/ld+json" set:html={articleStructuredData} />
  <script type="application/ld+json" set:html={breadcrumbStructuredData} />
  <main class="page">
    <article class="sheet blog-article-sheet">
      <nav class="topnav" aria-label="Primary navigation">
        <BrandLogo href={`${base}#home`} />
        <div class="navlinks">
          <a href={`${base}#home`}>Home</a>
          <a href={`${base}#about`}>About</a>
          <a href={`${base}#work`}>Projects</a>
          <a href={`${base}#experience`}>Experience</a>
          <a href={`${base}#skills`}>Skills</a>
          <a class="active" href={`${base}blogs/`}>Blogs</a>
          <a href={`${base}#contact`}>Contact</a>
        </div>
        <ThemeToggle />
      </nav>

      <article class="blog-post">
        <p class="blog-back"><a href={`${base}blogs/`}>← All blogs</a></p>
        <header class="blog-post-heading">
          <p class="blog-reading-time">
            <span>{Math.max(1, Math.ceil(post.body.split(/\s+/).length / 220))} min read</span>
          </p>
          <h1>{post.data.title}</h1>
          <p class="blog-description">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <p class="blog-tags article-tags">
              <BlogTags tags={post.data.tags} base={base} />
            </p>
          )}
        </header>
        <div class="blog-content">
          <Content />
        </div>
        {relatedPosts.length > 0 && (
          <aside class="related-posts" aria-labelledby="related-posts-title">
            <h2 id="related-posts-title">Related articles</h2>
            <ul>
              {relatedPosts.map((relatedPost) => (
                <li>
                  <a href={`${base}blogs/${relatedPost.slug}/`}>{relatedPost.data.title}</a>
                  <p>{relatedPost.data.description}</p>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
    </article>
  </main>
</SiteLayout>