---
import { getImage } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import PortfolioHome from "../components/PortfolioHome.astro";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";
import { SITE_URL } from "../consts";

const socialImage = await getImage({
  src: portrait,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "attention",
  format: "jpeg",
});
const personStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}#person`,
  name: "Sumit Kumar",
  url: SITE_URL,
  image: new URL(socialImage.src, SITE_URL).href,
  jobTitle: "DevOps Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bengaluru",
    addressCountry: "IN",
  },
  sameAs: [
    "https://github.com/sumiitkumar",
    "https://www.linkedin.com/in/sumiitkumar",
  ],
}).replaceAll("<", "\\u003c");
---

<SiteLayout
  title="Sumit Kumar | DevOps Engineer"
  description="Sumit Kumar is a DevOps Engineer building reliable cloud-native infrastructure, CI/CD platforms, and observability systems."
  keywords={["Sumit Kumar", "DevOps Engineer", "Kubernetes", "AWS", "Cloud Infrastructure", "Platform Engineering"]}
>
  <script type="application/ld+json" set:html={personStructuredData} />
  <PortfolioHome />
</SiteLayout>
