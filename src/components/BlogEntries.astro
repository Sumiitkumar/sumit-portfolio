---
import type { CollectionEntry } from "astro:content";
import BlogTags from "./BlogTags.astro";
import { BLOGS_PER_PAGE } from "../utils/blog-pagination";

interface Props {
  posts: CollectionEntry<"blogs">[];
  base: string;
  currentPage?: number;
  totalPages?: number;
  totalPosts?: number;
}

const {
  posts,
  base,
  currentPage = 1,
  totalPages = 1,
  totalPosts = posts.length,
} = Astro.props;
const firstPostNumber = totalPosts === 0 ? 0 : (currentPage - 1) * BLOGS_PER_PAGE + 1;
const pageUrl = (page: number) =>
  page === 1 ? `${base}blogs/` : `${base}blogs/page/${page}/`;
---

<section class="blog-list" aria-label="Published blog posts">
  {posts.length > 0 ? (
    posts.map((post) => (
      <article class="blog-entry">
        <h2><a href={`${base}blogs/${post.slug}/`}>{post.data.title}</a></h2>
        <div class="blog-entry-meta">
          <p class="blog-reading-time">
            <span>{Math.max(1, Math.ceil(post.body.split(/\s+/).length / 220))} min read</span>
          </p>
          {post.data.tags.length > 0 && (
            <p class="blog-tags">
              <BlogTags tags={post.data.tags} base={base} />
            </p>
          )}
        </div>
        <p class="blog-description">{post.data.description}</p>
        <a
          class="blog-read-more"
          href={`${base}blogs/${post.slug}/`}
          aria-label={`Read more: ${post.data.title}`}
        >
          Read More...
        </a>
      </article>
    ))
  ) : (
    <p class="blog-empty">No published posts yet.</p>
  )}
</section>

{totalPages > 1 && (
  <nav class="blog-pagination" aria-label="Blog pages">
    <span class="blog-pagination-status">
      Showing {firstPostNumber}–{Math.min(firstPostNumber + posts.length - 1, totalPosts)} of {totalPosts}
    </span>
    <div class="blog-pagination-links">
      {currentPage > 1 ? (
        <a class="blog-pagination-direction" href={pageUrl(currentPage - 1)} rel="prev">Previous</a>
      ) : (
        <span class="blog-pagination-direction" aria-disabled="true">Previous</span>
      )}
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
        <a
          class="blog-pagination-number"
          href={pageUrl(page)}
          aria-current={page === currentPage ? "page" : undefined}
          aria-label={`Page ${page}`}
        >
          {page}
        </a>
      ))}
      {currentPage < totalPages ? (
        <a class="blog-pagination-direction" href={pageUrl(currentPage + 1)} rel="next">Next</a>
      ) : (
        <span class="blog-pagination-direction" aria-disabled="true">Next</span>
      )}
    </div>
  </nav>
)}
