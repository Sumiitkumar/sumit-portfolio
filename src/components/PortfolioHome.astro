---
import { getImage } from "astro:assets";
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Boxes,
  Cloud,
  Code2,
  Download,
  Mail,
  MapPin,
  Rocket,
  Server,
  Terminal,
  Workflow,
} from "@lucide/astro";
import BrandLogo from "./BrandLogo.astro";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroPortrait = await getImage({
  src: portrait,
  width: 640,
  fit: "cover",
  position: "attention",
  format: "webp",
  quality: 78,
});

const skills = [
  { title: "Cloud platforms", items: ["AWS", "Azure", "EKS", "IAM"], icon: Cloud },
  { title: "Containers", items: ["Kubernetes", "Docker", "Helm", "Istio"], icon: Boxes },
  { title: "Infrastructure", items: ["Terraform", "Bicep", "GitOps", "ArgoCD"], icon: Workflow },
  { title: "Observability", items: ["Prometheus", "Grafana", "OpenTelemetry", "Kafka"], icon: Server },
];
---

<main class="portfolio">
  <nav class="site-nav" aria-label="Primary navigation">
    <BrandLogo href="#top" />
    <div class="nav-links">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#work">Projects</a>
      <a href={`${base}blogs/`}>Writing</a>
      <a href="#contact">Contact</a>
    </div>
    <a
      class="nav-resume"
      href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
      target="_blank"
      rel="noopener noreferrer"
    >View my resume <Download size={14} /></a>
    <div class="nav-socials" role="group" aria-label="Social profiles">
      <a href="https://github.com/sumiitkumar" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.56 1.2 3.18.92.1-.71.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.14-3-.12-.28-.5-1.42.1-2.96 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.6 1.54.22 2.68.1 2.96.71.78 1.14 1.78 1.14 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/sumiitkumar" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M5.2 3.5a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.4 9.2H7v11.4H3.4V9.2Zm5.8 0h3.5v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.2h-3.7v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9v5.6H9.2V9.2Z" />
        </svg>
      </a>
    </div>
    <a class="nav-contact" href="mailto:sumiitkumar.it@gmail.com">Let's talk <ArrowUpRight size={15} /></a>
  </nav>

  <header id="top" class="hero">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="availability-dot"></span> CLOUD · DEVOPS · PLATFORM ENGINEERING</p>
      <h1>Building reliable<br />systems for a<br /><span>connected world.</span></h1>
      <p class="hero-summary">
        I'm <strong>Sumit Kumar</strong>, a DevOps Engineer turning complex cloud
        infrastructure into platforms teams can ship with confidence.
      </p>
      <a class="mascot-guide" href="#work" aria-label="Meet Pip, your portfolio guide. Explore selected projects">
        <svg class="mascot-illustration" viewBox="0 0 56 60" role="img" aria-label="A friendly cloud robot waving">
          <path class="mascot-antenna" d="M28 13V8" />
          <circle class="mascot-antenna-tip" cx="28" cy="6" r="3" />
          <path class="mascot-body" d="M14 39h28v8a6 6 0 0 1-6 6h-3l-5 5-5-5h-3a6 6 0 0 1-6-6z" />
          <path class="mascot-arm mascot-arm-left" d="M14 34 8 39" />
          <path class="mascot-arm mascot-arm-right" d="m42 34 6-5" />
          <path class="mascot-head" d="M16 17a6 6 0 0 1 6-6h12a6 6 0 0 1 6 6v14a8 8 0 0 1-8 8h-8a8 8 0 0 1-8-8z" />
          <circle class="mascot-eye" cx="23" cy="24" r="1.8" />
          <circle class="mascot-eye" cx="33" cy="24" r="1.8" />
          <path class="mascot-smile" d="M23 30q5 5 10 0" />
          <path class="mascot-cheek" d="M18 29h3m16 0h3" />
        </svg>
        <span class="mascot-message">
          <span class="mascot-name">Pip, your portfolio guide</span>
          <span>New here? Take a look at my projects <ArrowRight size={13} /></span>
        </span>
      </a>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore my work <ArrowRight size={17} /></a>
        <a class="button button-secondary" href="mailto:sumiitkumar.it@gmail.com"><Mail size={16} /> Get in touch</a>
      </div>
      <div class="hero-location">
        <span class="location"><MapPin size={15} /> Bengaluru, India</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>
      <div class="portrait-card">
        <amp-img
          class="hero-portrait"
          src={heroPortrait.src}
          alt="Portrait of Sumit Kumar"
          width={heroPortrait.width}
          height={heroPortrait.height}
          layout="fill"
        ></amp-img>
        <div class="portrait-caption">
          <span class="caption-icon"><Code2 size={17} /></span>
          <span><strong>Engineer by craft</strong><small>Curious by default</small></span>
          <span class="caption-spark">✳</span>
        </div>
      </div>
      <div class="floating-chip chip-kubernetes"><span class="chip-dot"></span> Kubernetes</div>
      <div class="floating-chip chip-cloud"><Cloud size={15} /> Cloud native</div>
      <div class="terminal-dock" aria-label="Interactive portfolio terminal">
        <div class="terminal-title">
          <span class="terminal-lights"><i></i><i></i><i></i></span>
          <span><Terminal size={13} /> explore.sumit</span>
          <span class="terminal-ready"><i></i> ready</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-log">
            <p><span class="terminal-prompt">sumit@cloud:~$</span> help</p>
            <p class="terminal-output">Choose a command to explore the portfolio.</p>
          </div>
          <div class="terminal-suggestions" aria-label="Suggested commands">
            <a href="#about">about</a>
            <a href="#skills">skills</a>
            <a href="#experience">experience</a>
            <a href="#work">work</a>
            <a href="#contact">contact</a>
          </div>
        </div>
      </div>
      <div class="hero-index">01 <span>/</span> 04</div>
    </div>
    <a class="scroll-cue" href="#about"><ArrowDown size={15} /> SCROLL TO EXPLORE</a>
  </header>

  <section class="proof-bar" aria-label="Career highlights" data-reveal>
    <div class="proof-item"><strong>3<span>+</span></strong><span>years building<br />cloud platforms</span></div>
    <div class="proof-item"><strong>50<span>%</span></strong><span>faster incident<br />resolution</span></div>
    <div class="proof-item"><strong>10<span>+</span></strong><span>hours saved<br />each week</span></div>
    <div class="proof-note">Thoughtful systems.<br /><span>Measurable outcomes.</span></div>
  </section>

  <section id="about" class="content-section about-section">
    <div class="section-intro" data-reveal>
      <p class="eyebrow section-kicker">01 — A LITTLE ABOUT ME</p>
      <h2>Making complex<br />systems feel <span>simple.</span></h2>
    </div>
    <div class="about-copy" data-reveal>
      <p class="lead-copy">
        I work where cloud infrastructure, automation, and developer experience meet.
      </p>
      <p>
        From Kubernetes platforms to observability pipelines, I build the systems
        that help engineering teams move quickly without compromising reliability.
        I care about clear operations, useful automation, and infrastructure that
        gets out of the way.
      </p>
      <a
        class="text-link"
        href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >View my resume <Download size={15} /></a>
    </div>
  </section>

  <section id="experience" class="content-section experience-section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow section-kicker">02 — THE JOURNEY</p>
        <h2>Experience that <span>ships.</span></h2>
      </div>
      <p class="section-aside">A few chapters in building better<br />infrastructure and happier teams.</p>
    </div>
    <div class="experience-grid">
      <article class="experience-card" data-reveal>
        <div class="experience-meta"><span class="experience-period">DEC 2025 — MAR 2026</span><span class="experience-index">01</span></div>
        <h3>DevOps Engineer <span>at Maiora</span></h3>
        <p class="experience-location"><MapPin size={14} /> Bengaluru, India</p>
        <p class="experience-description">
          Built AI-assisted troubleshooting and end-to-end observability for
          cloud-native workloads, helping teams identify root causes faster.
        </p>
        <div class="tag-list"><span>Kubernetes</span><span>AWS</span><span>OpenTelemetry</span><span>GitOps</span></div>
      </article>
      <article class="experience-card" data-reveal>
        <div class="experience-meta"><span class="experience-period">JAN 2022 — JUN 2024</span><span class="experience-index">02</span></div>
        <h3>DevOps Engineer <span>at Brillio</span></h3>
        <p class="experience-location"><MapPin size={14} /> Bengaluru, India</p>
        <p class="experience-description">
          Automated cloud provisioning and delivery workflows, and built
          Kubernetes policy and identity solutions for enterprise teams.
        </p>
        <div class="tag-list"><span>Azure</span><span>Terraform</span><span>Kubernetes</span><span>CI/CD</span></div>
      </article>
    </div>
  </section>

  <section id="work" class="content-section work-section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow section-kicker">03 — THINGS I'VE BUILT</p>
        <h2>Selected <span>work.</span></h2>
      </div>
      <span class="work-count">02 FEATURED PROJECTS</span>
    </div>
    <div class="project-grid">
      <article class="project-card project-card-featured" data-reveal>
        <div class="project-art project-art-ai">
          <div class="project-art-glow"></div>
          <div class="project-window">
            <div class="window-dots"><i></i><i></i><i></i><span>cluster-assistant</span></div>
            <div class="window-code"><span class="code-muted">$</span> diagnose --cluster <span>production</span><br /><span class="code-ok">✓</span> logs collected<br /><span class="code-ok">✓</span> root cause identified<br /><span class="code-accent">→</span> 3 recommendations ready<span class="code-cursor"></span></div>
          </div>
          <span class="art-label">AI · OBSERVABILITY</span>
        </div>
        <div class="project-content">
          <div class="project-topline"><span>01 / INCIDENT RESPONSE</span><Rocket size={17} /></div>
          <h3>DevOps Agentic AI Assistant</h3>
          <p>AI-powered incident analysis for Kubernetes—bringing cluster signals, logs, and actionable guidance into one workflow.</p>
          <div class="tag-list"><span>Python</span><span>Kubernetes</span><span>Prometheus</span><span>AWS</span></div>
        </div>
      </article>
      <article class="project-card" data-reveal>
        <div class="project-art project-art-k8s">
          <div class="cluster-diagram">
            <span class="cluster-node node-user">Custom Resource</span>
            <span class="cluster-line"></span>
            <span class="cluster-node node-controller"><Boxes size={20} /> Reconcile</span>
            <span class="cluster-branches"><i></i><i></i><i></i></span>
            <span class="cluster-node node-pod">Deployment</span>
          </div>
          <span class="art-label">KUBERNETES · AUTOMATION</span>
        </div>
        <div class="project-content">
          <div class="project-topline"><span>02 / PLATFORM ENGINEERING</span><Workflow size={17} /></div>
          <h3>Kubernetes Custom Controller</h3>
          <p>A Go controller that reconciles application resources and automates lifecycle management across Kubernetes clusters.</p>
          <div class="tag-list"><span>Go</span><span>Kubebuilder</span><span>CRDs</span><span>client-go</span></div>
        </div>
      </article>
    </div>
  </section>

  <section id="skills" class="content-section skills-section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow section-kicker">04 — MY TOOLKIT</p>
        <h2>Built on the <span>right tools.</span></h2>
      </div>
      <p class="section-aside">Always learning. Always improving<br />the way systems work.</p>
    </div>
    <div class="skills-grid">
      {skills.map(({ title, items, icon: Icon }, index) => (
        <article class="skill-card" data-reveal>
          <div class="skill-card-top"><span class="skill-icon"><Icon size={19} /></span><span>0{index + 1}</span></div>
          <h3>{title}</h3>
          <div class="tag-list">{items.map((item) => <span>{item}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="writing-banner" aria-labelledby="writing-title" data-reveal>
    <span class="writing-icon"><BookOpen size={22} /></span>
    <div><p class="eyebrow section-kicker">05 — WRITING</p><h2 id="writing-title">Latest from the <span>blog.</span></h2><p>Practical notes from building, breaking, and improving cloud systems.</p></div>
    <a class="button button-light" href={`${base}blogs/`}>Read the blog <ArrowUpRight size={17} /></a>
  </section>

  <section id="contact" class="contact-section" data-reveal>
    <p class="eyebrow section-kicker">HAVE A GOOD CHALLENGE?</p>
    <h2>Let's build something<br /><span>that matters.</span></h2>
    <p class="contact-copy">If you're working on cloud platforms, reliability, or a more enjoyable developer experience, I'd love to hear from you.</p>
    <a class="button button-primary" href="mailto:sumiitkumar.it@gmail.com">Start a conversation <ArrowUpRight size={17} /></a>
    <div class="contact-foot"><span>Usually replies within a day</span><span>·</span><span>Bengaluru, India</span></div>
  </section>

</main>
