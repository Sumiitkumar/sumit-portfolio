---
import {
  ArrowRight,
  Boxes,
  Cloud,
  Download,
  Mail,
  Rocket,
  Server,
  Workflow,
} from "@lucide/astro";
import {
  siArgo,
  siBitbucket,
  siDocker,
  siGit,
  siGithub,
  siGithubactions,
  siGooglecloud,
  siGrafana,
  siGnubash,
  siHelm,
  siKubernetes,
  siLinux,
  siMlflow,
  siNvidia,
  siOpentelemetry,
  siPrometheus,
  siTerraform,
  siTrivy,
  siVllm,
  siYaml,
} from "simple-icons";
import BrandLogo from "./BrandLogo.astro";
import BlogTags from "./BlogTags.astro";
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroName = Array.from("Sumit Kumar");
const heroRole = Array.from(" AI DevOps Engineer");
const aboutGreeting = Array.from("Hey, I am Sumit Kumar");
const aboutRole = Array.from("AI DevOps Engineer");

const skillLogos = new Map<string, { hex: string; path: string }>([
  ["GCP", siGooglecloud],
  ["Docker", siDocker],
  ["Kubernetes", siKubernetes],
  ["Helm", siHelm],
  ["Linux/Unix", siLinux],
  ["On-Premise Infrastructure", siLinux],
  ["NVIDIA DRA", siNvidia],
  ["NVIDIA MIG", siNvidia],
  ["GPU Time-Slicing", siNvidia],
  ["HAMi", siNvidia],
  ["Run:ai", siNvidia],
  ["Kueue", siKubernetes],
  ["Volcano", siKubernetes],
  ["Kamaji", siKubernetes],
  ["vLLM", siVllm],
  ["KServe", siKubernetes],
  ["NVIDIA Triton", siNvidia],
  ["MLflow", siMlflow],
  ["LLM Serving", siVllm],
  ["Inference Observability", siOpentelemetry],
  ["GitHub Actions", siGithubactions],
  ["GitOps", siArgo],
  ["ArgoCD", siArgo],
  ["Terraform", siTerraform],
  ["Shell/Bash", siGnubash],
  ["YAML", siYaml],
  ["Prometheus", siPrometheus],
  ["Grafana", siGrafana],
  ["ScienceLogic", siOpentelemetry],
  ["Alerting", siPrometheus],
  ["DevSecOps", siTrivy],
  ["Git", siGit],
  ["GitHub", siGithub],
  ["Bitbucket", siBitbucket],
  ["Cost Optimization", siGooglecloud],
]);

const skills = [
  {
    title: "Cloud & Infrastructure",
    items: ["AWS", "Azure", "GCP", "Docker", "Kubernetes", "Helm", "Linux/Unix", "On-Premise Infrastructure"],
    icon: Cloud,
  },
  {
    title: "GPU Infrastructure & Scheduling",
    items: ["NVIDIA DRA", "NVIDIA MIG", "GPU Time-Slicing", "HAMi", "Run:ai", "Kueue", "Volcano", "Kamaji"],
    icon: Server,
  },
  {
    title: "LLMOps & Model Serving",
    items: ["vLLM", "KServe", "NVIDIA Triton", "MLflow", "LLM Serving", "Inference Observability"],
    icon: Boxes,
  },
  {
    title: "CI/CD & Automation",
    items: ["GitHub Actions", "Azure DevOps", "GitOps", "ArgoCD", "Terraform", "Shell/Bash", "YAML"],
    icon: Workflow,
  },
  {
    title: "Monitoring & Observability",
    items: ["Prometheus", "Grafana", "ScienceLogic", "Seq", "Alerting"],
    icon: Server,
  },
  {
    title: "Security & Collaboration",
    items: ["DevSecOps", "Git", "GitHub", "Bitbucket", "Cost Optimization"],
    icon: Boxes,
  },
];
---

<main class="portfolio">
  <nav class="site-nav" aria-label="Primary navigation">
    <BrandLogo href="#home" />
    <ThemeToggle />
    <div class="nav-links">
      <a href="#home" data-section-link aria-current="page">Home</a>
      <a href="#about" data-section-link>About</a>
      <a href="#work" data-section-link>Projects</a>
      <a href="#experience" data-section-link>Experience</a>
      <a href="#skills" data-section-link>Skills</a>
      <a href={`${base}blogs/`}>Blogs</a>
    </div>
    <a
      class="nav-resume"
      href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
      target="_blank"
      rel="noopener noreferrer"
    >Download my resume <Download size={16} /></a>
    <div class="nav-socials" role="group" aria-label="Social profiles">
      <a href="https://github.com/sumiitkumar" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.56 1.2 3.18.92.1-.71.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.14-3-.12-.28-.5-1.42.1-2.96 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.6 1.54.22 2.68.1 2.96.71.78 1.14 1.78 1.14 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/sumiitkumar" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M5.2 3.5a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.4 9.2H7v11.4H3.4V9.2Zm5.8 0h3.5v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.2h-3.7v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9v5.6H9.2V9.2Z" />
        </svg>
      </a>
      <a href="mailto:sumiitkumar.it@gmail.com" aria-label="Email Sumit">
        <Mail class="brand-social-icon" size={18} aria-hidden="true" />
      </a>
    </div>
  </nav>

  <section
    id="home"
    data-scroll-section
    aria-labelledby="home-title"
  >
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">HOME</p>
        <h1 id="home-title" aria-label="Sumit Kumar, DevOps Engineer">
          <span class="hero-title-line" aria-hidden="true">
            {heroName.map((letter, index) => (
              <span class="hero-title-letter" style={`--letter-delay: ${index * 70}ms`}>{letter === " " ? "\u00a0" : letter}</span>
            ))}
          </span>
          <br />
          <span class="hero-title-line hero-title-role" aria-hidden="true">
            {heroRole.map((letter, index) => (
              <span class="hero-title-letter" style={`--letter-delay: ${(index + heroName.length + 5) * 70}ms`}>{letter === " " ? "\u00a0" : letter}</span>
            ))}
          </span>
        </h1>
        <p class="hero-summary">
          I build Kubernetes platforms, automate cloud infrastructure, and improve delivery workflows.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <ArrowRight size={17} /></a>
          <a class="button button-secondary" href="#contact">Contact me <ArrowRight size={16} /></a>
        </div>
      </div>
    </header>

  </section>

  <section id="about" class="content-section about-section" data-scroll-section aria-labelledby="about-title">
    <div class="section-intro">
      <p class="eyebrow section-kicker">ABOUT ME</p>
      <h2 id="about-title" aria-label="Hey, I am Sumit Kumar, AI DevOps Engineer">
        <span class="hero-title-line" aria-hidden="true">
          {aboutGreeting.map((letter, index) => (
            <span class="hero-title-letter" style={`--letter-delay: ${index * 55}ms`}>{letter === " " ? "\u00a0" : letter}</span>
          ))}
        </span>
        <br />
        <span class="hero-title-line hero-title-role" aria-hidden="true">
          {aboutRole.map((letter, index) => (
            <span class="hero-title-letter" style={`--letter-delay: ${(index + aboutGreeting.length + 3) * 55}ms`}>{letter === " " ? "\u00a0" : letter}</span>
          ))}
        </span>
      </h2>
      <div class="about-copy">
        <p>
          I’m an AI DevOps Engineer with 3+ years of experience building reliable
          cloud infrastructure, Kubernetes platforms, and delivery workflows.
          I focus on practical automation that makes systems easier to operate
          and safer to change.
        </p>
        <p>
          I’m especially interested in GPU infrastructure and scheduling:
          NVIDIA DRA, MIG, time-slicing, HAMi, and Run:ai, plus Kubernetes
          workload schedulers like Kueue and Volcano. I also explore multi-tenant
          Kubernetes with Kamaji and LLMOps tools for serving and observing models.
        </p>
        <a
          class="text-link"
          href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
        >View my resume <Download size={15} /></a>
      </div>
    </div>
    <div class="about-metrics" role="list" aria-label="Career impact">
      <article class="about-metric" role="listitem">
        <p class="about-metric-value">3+</p>
        <p class="about-metric-label">Years Experience</p>
      </article>
      <article class="about-metric" role="listitem">
        <p class="about-metric-value">99.9%</p>
        <p class="about-metric-label">Uptime Maintained</p>
      </article>
      <article class="about-metric" role="listitem">
        <p class="about-metric-value">80%</p>
        <p class="about-metric-label">Deployment Time Reduced</p>
      </article>
      <article class="about-metric" role="listitem">
        <p class="about-metric-value">25%</p>
        <p class="about-metric-label">Cost Savings Achieved</p>
      </article>
    </div>
  </section>

  <section id="work" class="content-section work-section" data-scroll-section aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">SELECTED WORK</p>
        <h2 id="projects-title">Systems built to solve <span>real problems.</span></h2>
      </div>
      <span class="work-count">02 PROJECT CASE STUDIES</span>
    </div>
    <div class="project-grid">
      <article class="project-card project-card-featured">
        <div class="project-content">
          <div class="project-topline"><span>INCIDENT RESPONSE</span><Rocket size={17} /></div>
          <h3>Kubernetes incident response assistant</h3>
          <p>
            An AI-assisted workflow for collecting Kubernetes and cloud signals,
            narrowing likely causes, and giving responders useful next steps.
            Built alongside an observability platform to shorten incident
            investigation and reduce mean time to resolution by 50%.
          </p>
          <div class="tag-list">
            <BlogTags tags={["Kubernetes", "Observability", "Troubleshooting"]} base={base} />
          </div>
          <a class="project-link" href={`${base}blogs/debugging-pending-gpu-pods/`}>
            Read a Kubernetes troubleshooting case study <ArrowRight size={15} />
          </a>
        </div>
      </article>
      <article class="project-card">
        <div class="project-content">
          <div class="project-topline"><span>PLATFORM ENGINEERING</span><Workflow size={17} /></div>
          <h3>Kubernetes policy and platform automation</h3>
          <p>
            Custom admission controls validate and mutate resources before they
            reach a cluster, while GitOps workflows keep platform configuration
            consistent across environments.
          </p>
          <div class="tag-list">
            <BlogTags tags={["Kubernetes", "Platform engineering", "Device plugins"]} base={base} />
          </div>
          <a
            class="project-link"
            href="https://github.com/sumiitkumar"
            target="_blank"
            rel="noopener noreferrer"
          >
            Browse public work on GitHub <ArrowRight size={15} />
          </a>
        </div>
      </article>
    </div>
  </section>

  <section id="experience" class="content-section experience-section" data-scroll-section aria-labelledby="experience-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">THE JOURNEY</p>
        <h2 id="experience-title">Where I’ve Worked</h2>
      </div>
    </div>
    <div class="experience-grid">
      <article class="experience-card">
        <div class="experience-meta"><span class="experience-period">DEC 2025 — MAR 2026</span><span class="experience-location">Bengaluru, India</span></div>
        <h3>DevOps Engineer <span>at Maiora</span></h3>
        <ul class="experience-bullets">
          <li>Engineered an AI-powered troubleshooting assistant for Kubernetes and cloud infrastructure, reducing MTTR by 50% through automated root-cause analysis.</li>
          <li>Built an observability platform with Prometheus, Grafana, OpenTelemetry, Vector, Kafka, and ClickHouse, cutting troubleshooting time by 50%.</li>
          <li>Orchestrated GitOps-based CI/CD pipelines for multiple daily production releases while maintaining deployment reliability.</li>
          <li>Implemented OIDC with AWS IAM Roles for Service Accounts (IRSA), eliminating static IAM credentials.</li>
          <li>Integrated Trivy container vulnerability scanning into deployment pipelines to help ensure compliance and prevent high-severity flaws in production.</li>
          <li>Led migration of enterprise container images to a private Harbor registry, standardizing image security and management.</li>
          <li>Configured Istio for traffic management, mutual TLS encryption, and cross-service observability.</li>
        </ul>
      </article>
      <article class="experience-card">
        <div class="experience-meta"><span class="experience-period">JAN 2022 — JUN 2024</span><span class="experience-location">Bengaluru, India</span></div>
        <h3>DevOps Engineer <span>at Brillio</span></h3>
        <ul class="experience-bullets">
          <li>Built a custom Kubernetes Admission Controller to validate and mutate resource configurations before deployment, enforcing enterprise security policies.</li>
          <li>Automated multi-environment cloud provisioning with reusable Azure ARM/Bicep templates, reducing manual setup effort by 35%.</li>
          <li>Developed Python and PowerShell scripts that streamlined operations and saved more than 10 engineering hours each week.</li>
          <li>Implemented Azure Entra ID identity management and granular role-based access control across cloud resources.</li>
          <li>Automated incident workflows with Azure Logic Apps to detect Data Factory failures and create Azure DevOps work items, cutting response time by 40%.</li>
        </ul>
      </article>
    </div>
  </section>

  <section id="skills" class="content-section skills-section" data-scroll-section aria-labelledby="skills-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">TECH SKILLS</p>
        <h2 id="skills-title">Technologies I Work With</h2>
      </div>
    </div>
    <div class="skills-grid">
      {skills.map(({ title, items, icon: Icon }) => (
        <article class="skill-card">
          <div class="skill-card-heading">
            <span class="skill-icon"><Icon size={19} /></span>
            <h3>{title}</h3>
          </div>
          <div class="skill-tags">
            {items.map((item) => {
              const logo = skillLogos.get(item);
              return (
                <span class="skill-tag">
                  {logo ? (
                    <svg
                      class="skill-tag-logo"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      style={`color: #${logo.hex}`}
                    >
                      <path d={logo.path} />
                    </svg>
                  ) : (
                    <Icon class="skill-tag-logo skill-tag-fallback" size={16} aria-hidden="true" />
                  )}
                  {item}
                </span>
              );
            })}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="content-section contact-section" data-scroll-section aria-labelledby="contact-title">
    <div class="section-intro">
      <p class="eyebrow section-kicker">CONTACT</p>
      <h2 id="contact-title">Let’s talk about building better platforms.</h2>
      <p class="contact-copy">
        Have a cloud, Kubernetes, or platform engineering challenge in mind?
        Send me a note and tell me what you’re working on.
      </p>
      <a class="button button-primary contact-email" href="mailto:sumiitkumar.it@gmail.com">
        <Mail size={17} /> Email Sumit
      </a>
    </div>
    <div class="contact-links" aria-label="Other ways to connect">
      <a href="https://www.linkedin.com/in/sumiitkumar" target="_blank" rel="noopener noreferrer">
        LinkedIn <ArrowRight size={15} />
      </a>
      <a href="https://github.com/sumiitkumar" target="_blank" rel="noopener noreferrer">
        GitHub <ArrowRight size={15} />
      </a>
    </div>
  </section>

</main>

<script src="/portfolio-tabs.js" defer is:inline></script>
