---
import {
  ArrowRight,
  Boxes,
  Cloud,
  Download,
  Mail,
  Rocket,
  Server,
  Workflow,
} from "@lucide/astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profilePhoto from "../../assets/sumit-profile.png";
import BrandLogo from "./BrandLogo.astro";
import BlogEntries from "./BlogEntries.astro";
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const visitorCounterEndpoint = import.meta.env.PUBLIC_VISITOR_COUNTER_URL ?? "";
const posts = (await getCollection("blogs", ({ data }) => !data.draft)).sort(
  (first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
);

const skills = [
  { title: "Cloud platforms", items: ["AWS", "Azure", "EKS", "IAM"], icon: Cloud },
  { title: "Containers", items: ["Kubernetes", "Docker", "Helm", "Istio"], icon: Boxes },
  { title: "Infrastructure", items: ["Terraform", "Bicep", "GitOps", "ArgoCD"], icon: Workflow },
  { title: "Observability", items: ["Prometheus", "Grafana", "OpenTelemetry", "Kafka"], icon: Server },
];
---

<main class="portfolio">
  <nav class="site-nav" aria-label="Primary navigation">
    <BrandLogo href="#blogs" />
    <ThemeToggle />
    <div class="sidebar-profile">
      <Image
        src={profilePhoto}
        alt="Sumit Kumar"
        width={160}
        height={160}
        fit="cover"
        position="top"
        loading="eager"
      />
    </div>
    <div class="nav-links">
      <a href="#blogs" data-portfolio-tab aria-current="page">Blogs</a>
      <a href="#about" data-portfolio-tab>About</a>
      <a href="#skills" data-portfolio-tab>Skills</a>
      <a href="#experience" data-portfolio-tab>Experience</a>
      <a href="#work" data-portfolio-tab>Projects</a>
      <a href="mailto:sumiitkumar.it@gmail.com">Contact</a>
    </div>
    <a
      class="nav-resume"
      href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
      target="_blank"
      rel="noopener noreferrer"
    >Download my resume <Download size={16} /></a>
    <div class="nav-socials" role="group" aria-label="Social profiles">
      <a href="https://github.com/sumiitkumar" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.56 1.2 3.18.92.1-.71.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.14-3-.12-.28-.5-1.42.1-2.96 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.6 1.54.22 2.68.1 2.96.71.78 1.14 1.78 1.14 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
      </a>
      <a href="mailto:sumiitkumar.it@gmail.com" aria-label="Send email">
        <Mail class="brand-social-icon" size={18} aria-hidden="true" />
      </a>
      <a href="https://www.linkedin.com/in/sumiitkumar" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg class="brand-social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M5.2 3.5a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.4 9.2H7v11.4H3.4V9.2Zm5.8 0h3.5v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.2h-3.7v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9v5.6H9.2V9.2Z" />
        </svg>
      </a>
    </div>
  </nav>

  <section id="blogs" class="portfolio-panel blog-home-panel" data-portfolio-panel aria-labelledby="home-blogs-title">
    <BlogEntries posts={posts} base={base} />
  </section>

  <section
    id="about"
    class="portfolio-panel"
    data-portfolio-panel
    aria-labelledby="about-title"
    hidden
  >
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">CLOUD · DEVOPS · PLATFORM ENGINEERING</p>
        <h1 id="about-title" class="about-title" aria-label="I am Sumit Kumar, DevOps Engineer">
          <span class="sr-only">I am Sumit Kumar, DevOps Engineer</span>
          <span class="typewriter-line" data-typewriter-text="I am Sumit Kumar," aria-hidden="true"></span>
          <span class="typewriter-line" data-typewriter-text="DevOps Engineer" aria-hidden="true"></span>
        </h1>
        <p class="hero-summary">
          I build Kubernetes platforms, automate cloud infrastructure, and improve delivery workflows.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <ArrowRight size={17} /></a>
          <a class="button button-secondary" href="mailto:sumiitkumar.it@gmail.com"><Mail size={16} /> Get in touch</a>
        </div>
      </div>

    </header>

    <section
      class="visitor-counter"
      aria-labelledby="visitor-counter-title"
      data-visitor-counter
      data-counter-endpoint={visitorCounterEndpoint}
    >
      <div class="visitor-copy">
        <p class="eyebrow">WELCOME</p>
        <h2 id="visitor-counter-title">Welcome to my <span>DevOps Cloud Engineering</span> portfolio.</h2>
        <p>A little corner of the internet for cloud platforms, automation, and reliable systems.</p>
      </div>
      <div class="visitor-total">
        <span class="visitor-total-label">Portfolio visitors</span>
        <strong data-visitor-count aria-live="polite" aria-atomic="true">—</strong>
        <span class="visitor-total-status" data-visitor-status role="status" aria-live="polite">
          Connecting to the live counter…
        </span>
      </div>
    </section>

    <div class="proof-bar" aria-label="Career highlights">
      <div class="proof-item"><strong>3+ years</strong><span>Across cloud and platform engineering roles</span></div>
      <div class="proof-item"><strong>Incident response</strong><span>AI-assisted Kubernetes troubleshooting and observability</span></div>
      <div class="proof-item"><strong>Cloud automation</strong><span>Provisioning, delivery workflows, and custom controllers</span></div>
    </div>

    <section class="content-section about-section">
      <div class="section-intro">
        <p class="eyebrow section-kicker">A LITTLE ABOUT ME</p>
        <h2>Making complex<br />systems feel <span>simple.</span></h2>
      </div>
      <div class="about-copy">
        <p class="lead-copy">
          I’m Sumit Kumar, a DevOps Engineer with 3+ years of experience building
          cloud infrastructure, Kubernetes platforms, and automation.
        </p>
        <p>
          At Maiora, I worked on AI-assisted Kubernetes troubleshooting and
          observability for cloud-native workloads. Earlier, at Brillio, I automated
          cloud provisioning and CI/CD workflows and built Kubernetes policy and
          identity solutions. I enjoy making infrastructure more reliable and
          helping teams ship with confidence.
        </p>
        <a
          class="text-link"
          href="https://drive.google.com/file/d/14JExFr7vLTKWMXnw3isw1m4GHcfAI9k9/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
        >View my resume <Download size={15} /></a>
      </div>
    </section>
  </section>

  <section id="work" class="portfolio-panel content-section work-section" data-portfolio-panel aria-labelledby="projects-title" hidden>
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">02 — SELECTED WORK</p>
        <h2 id="projects-title">What I <span>build.</span></h2>
      </div>
      <span class="work-count">02 FEATURED PROJECTS</span>
    </div>
    <div class="project-grid">
      <article class="project-card project-card-featured">
        <div class="project-art project-art-ai">
          <div class="project-window">
            <div class="window-dots"><i></i><i></i><i></i><span>cluster-assistant</span></div>
            <div class="window-code"><span class="code-muted">$</span> diagnose --cluster <span>production</span><br /><span class="code-ok">✓</span> logs collected<br /><span class="code-ok">✓</span> root cause identified<br /><span class="code-accent">→</span> recommendations ready</div>
          </div>
          <span class="art-label">AI · OBSERVABILITY</span>
        </div>
        <div class="project-content">
          <div class="project-topline"><span>01 / INCIDENT RESPONSE</span><Rocket size={17} /></div>
          <h3>DevOps Agentic AI Assistant</h3>
          <p><strong>Outcome:</strong> Kubernetes signals, logs, and recommendations in one incident-response workflow.</p>
          <div class="tag-list"><span>Python</span><span>Kubernetes</span><span>Prometheus</span><span>AWS</span></div>
        </div>
      </article>
      <article class="project-card">
        <div class="project-art project-art-k8s">
          <div class="cluster-diagram">
            <span class="cluster-node node-user">Custom Resource</span>
            <span class="cluster-line"></span>
            <span class="cluster-node node-controller"><Boxes size={20} /> Reconcile</span>
            <span class="cluster-branches"><i></i><i></i><i></i></span>
            <span class="cluster-node node-pod">Deployment</span>
          </div>
          <span class="art-label">KUBERNETES · AUTOMATION</span>
        </div>
        <div class="project-content">
          <div class="project-topline"><span>02 / PLATFORM ENGINEERING</span><Workflow size={17} /></div>
          <h3>Kubernetes Custom Controller</h3>
          <p><strong>Outcome:</strong> Application resources reconcile automatically to their declared cluster configuration.</p>
          <div class="tag-list"><span>Go</span><span>Kubebuilder</span><span>CRDs</span><span>client-go</span></div>
        </div>
      </article>
    </div>
  </section>

  <section id="experience" class="portfolio-panel content-section experience-section" data-portfolio-panel aria-labelledby="experience-title" hidden>
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">03 — THE JOURNEY</p>
        <h2 id="experience-title">Experience that <span>ships.</span></h2>
      </div>
      <p class="section-aside">A few chapters in building better<br />infrastructure and happier teams.</p>
    </div>
    <div class="experience-grid">
      <article class="experience-card">
        <div class="experience-meta"><span class="experience-period">DEC 2025 — MAR 2026</span><span class="experience-index">01</span></div>
        <h3>DevOps Engineer <span>at Maiora</span></h3>
        <p class="experience-description">
          Built AI-assisted troubleshooting and end-to-end observability for
          cloud-native workloads, helping teams identify root causes faster.
        </p>
        <div class="tag-list"><span>Kubernetes</span><span>AWS</span><span>OpenTelemetry</span><span>GitOps</span></div>
      </article>
      <article class="experience-card">
        <div class="experience-meta"><span class="experience-period">JAN 2022 — JUN 2024</span><span class="experience-index">02</span></div>
        <h3>DevOps Engineer <span>at Brillio</span></h3>
        <p class="experience-description">
          Automated cloud provisioning and delivery workflows, and built
          Kubernetes policy and identity solutions for enterprise teams.
        </p>
        <div class="tag-list"><span>Azure</span><span>Terraform</span><span>Kubernetes</span><span>CI/CD</span></div>
      </article>
    </div>
  </section>

  <section id="skills" class="portfolio-panel content-section skills-section" data-portfolio-panel aria-labelledby="skills-title" hidden>
    <div class="section-heading">
      <div>
        <p class="eyebrow section-kicker">05 — TECH SKILLS</p>
        <h2 id="skills-title">Built on the <span>right tools.</span></h2>
      </div>
      <p class="section-aside">Always learning. Always improving<br />the way systems work.</p>
    </div>
    <div class="skills-grid">
      {skills.map(({ title, items, icon: Icon }, index) => (
        <article class="skill-card">
          <div class="skill-card-top"><span class="skill-icon"><Icon size={19} /></span><span>0{index + 1}</span></div>
          <h3>{title}</h3>
          <div class="tag-list">{items.map((item) => <span>{item}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

</main>

<script src="/portfolio-tabs.js" defer is:inline></script>
<script src="/visitor-counter.js" defer is:inline></script>
