---
import { getImage } from "astro:assets";
import portrait from "../../assets/WhatsApp Image 2025-09-10 at 3.46.09 PM.jpeg";

interface Props {
  href: string;
}

const { href } = Astro.props;
const brandPhoto = await getImage({
  src: portrait,
  width: 88,
  height: 88,
  fit: "cover",
  position: "attention",
  format: "webp",
});
---

<a class="brand-logo" href={href} aria-label="Sumit Kumar, home">
  <amp-img
    class="brand-photo"
    src={brandPhoto.src}
    alt=""
    width={88}
    height={88}
    layout="fixed"
  ></amp-img>
  <span class="brand-name">Sumit Kumar<small>DEVOPS ENGINEER</small></span>
</a>
